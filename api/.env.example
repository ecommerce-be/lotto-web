# copiare in .env e adattare
#
# Porta 5433: il docker-compose usa la 5433 perche' la 5432 e' occupata dal
# PostgreSQL installato nativamente. Se invece vuoi usare quello nativo,
# metti 5432 e crea utente e database con psql (vedi README).
DATABASE_URL=postgresql+psycopg://lotto:lotto@localhost:5433/lotto
ARCHIVIO_CSV=../docs/lotto-archivio-completo-1939-oggi.csv

# Aggiornamento serale interno all'applicazione (l'utilita' di pianificazione di
# Windows non e' accessibile da questo profilo: si veda il README).
AGGIORNAMENTO_AUTOMATICO=true
ORA_AGGIORNAMENTO=20:45
